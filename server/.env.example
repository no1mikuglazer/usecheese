# Cheese server — configuration template.
#
# Copy this file to `.env` and fill in real values for local development:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. In production these values
# are set in the host's dashboard (Railway → service → Variables) instead of
# being uploaded as a file.

# Port the API listens on locally. In production the host injects PORT itself.
PORT=3001

# Path to the SQLite database. Relative paths resolve against server/.
#
# Locally this is the full imported database. In production it points at the
# mounted persistent volume, and usually at the SMALLER derived database —
# the full one is ~1GB and does not fit a 500MB volume, e.g.
# DB_PATH=/data/cheese.small.sqlite
# See "Deriving a smaller database" in README.md for how that file is built.
DB_PATH=./data/cheese.sqlite

# Path to the user-accounts SQLite database. Deliberately a SEPARATE file
# from DB_PATH — see "Why the user database is a separate file" in
# README.md. The relative default below is correct for local dev, but in
# production this MUST be set to a path on the same mounted persistent
# volume as DB_PATH (e.g. USERS_DB_PATH=/data/cheese-users.sqlite) —
# config.js now fails to boot in production if this isn't set explicitly.
# Leaving it on the default there resolves inside the container's own
# ephemeral filesystem, not the volume, which silently wipes every
# account on the next deploy. This is not hypothetical — it's exactly
# what happened before this check existed.
USERS_DB_PATH=./data/cheese-users.sqlite

# Comma-separated list of browser origins allowed to call this API.
# In development any localhost port is also accepted automatically.
# In production, set this to the real site origin(s), e.g.
# CORS_ORIGINS=https://usecheese.xyz,https://www.usecheese.xyz
CORS_ORIGINS=http://localhost:5500

# development | production
NODE_ENV=development

# Clerk (accounts). CLERK_PUBLISHABLE_KEY is public — the same value
# everywhere, safe to commit; it's already embedded directly in every
# frontend page's HTML too. CLERK_SECRET_KEY is NOT public — get your own
# from Clerk Dashboard → API keys and never commit it. In production both
# are set in Railway's Variables, like everything else on this list.
CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudXNlY2hlZXNlLnh5eiQ
CLERK_SECRET_KEY=

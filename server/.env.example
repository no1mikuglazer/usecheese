# Cheese server — configuration template.
#
# Copy this file to `.env` and fill in real values for local development:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. In production these values
# are set in the host's dashboard (Railway → service → Variables) instead of
# being uploaded as a file.

# Port the API listens on locally. In production the host injects PORT itself.
PORT=3001

# Path to the SQLite database. Relative paths resolve against server/.
# In production this points at the mounted persistent volume, e.g.
# /data/cheese.sqlite
DB_PATH=./data/cheese.sqlite

# Comma-separated list of browser origins allowed to call this API.
# In development any localhost port is also accepted automatically.
# In production, set this to the real site origin(s), e.g.
# CORS_ORIGINS=https://usecheese.xyz,https://www.usecheese.xyz
CORS_ORIGINS=http://localhost:5500

# development | production
NODE_ENV=development
